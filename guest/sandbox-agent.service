# Started when the microVM reaches multi-user. One command, then the
# process exits. The controller kills the VM after that, so Restart=no.
[Unit]
Description=Sandbox vsock command agent
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/sandbox/agent.py
Restart=no

[Install]
WantedBy=multi-user.target
